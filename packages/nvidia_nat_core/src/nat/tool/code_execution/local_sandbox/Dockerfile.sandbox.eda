# The sandbox with an open-source RTL toolchain, for tasks that ask the agent to design
# hardware. A layer on top of nat-sandbox rather than a rewrite of it, so the default image
# keeps every byte it had and a run that asks for nothing meets the sandbox every collected
# run met. Selected with MARKAGENTX_SANDBOX_IMAGE=nat-sandbox-eda.
#
#   docker build --network host -t nat-sandbox-eda -f Dockerfile.sandbox.eda .
#
# --network host, because the builder's own network corrupts a large download: torch's
# 768 MB wheel arrived with the wrong sha256 under `docker build` and the right one under
# `docker run`, same URL, same daemon, a minute apart.
#
# The loop this exists for is write -> simulate -> read the failure -> fix -> synthesise ->
# read the gate count and the critical path -> optimise. Every number in it comes off a tool
# rather than out of the model, which is the only kind an agent cannot talk itself into.
FROM nat-sandbox

# iverilog simulates the source directly; verilator compiles it to C++ and needs a host
# compiler and make to build what it emits. yosys, magic, netgen and klayout are deliberately
# absent: they arrive from the nix store below, newer, and Debian's would only be shadowed.
# gtkwave is here for its command-line converters; the viewer itself needs a display.
RUN apt update \
 && apt install -y --no-install-recommends \
      iverilog verilator make gcc g++ libc6-dev git \
      ghdl \
      z3 boolector \
      nextpnr-ice40 fpga-icestorm \
      gcc-riscv64-unknown-elf \
      gtkwave \
 && apt clean && rm -rf /var/lib/apt/lists/*

# The rest of the flow: yosys ends at a gate netlist, and a netlist is not a chip. OpenROAD
# places and routes it, magic and netgen check the result against the rules and the schematic,
# klayout reads the GDSII that comes out.
#
# Taken from OpenLane's own image rather than installed: OpenROAD is not packaged for Debian,
# the .deb Precision Innovations publishes wants libpython3.9 which bookworm does not carry,
# and the relocatable tarball needs glibc 2.38 against this base's 2.36. OpenLane's build is
# Nix, so every dependency it has is inside /nix/store and the whole store copies across and
# runs -- 4.3 GB for a toolchain that would otherwise need a different base image.
COPY --from=ghcr.io/efabless/openlane2:2.0.3 /nix/store /nix/store

# Nix addresses a tool by a hash no one can type, so each one gets a name on PATH. The store's
# yosys is 0.38 against Debian's 0.23 and its sta is current where Debian's is from 2019, so
# the links go in /usr/local/bin, which precedes /usr/bin: the newer pair wins for everything,
# and nothing that already ran against the older ones has to change.
RUN set -eu; for t in openroad klayout magic netgen; do \
      f=$(ls -d /nix/store/*/bin/$t 2>/dev/null | head -1); \
      [ -n "$f" ] && ln -sf "$f" /usr/local/bin/$t; \
    done; \
    ln -sf "$(ls -d /nix/store/*yosys-with-plugins/bin/yosys | head -1)" /usr/local/bin/yosys; \
    ln -sf "$(ls -d /nix/store/*opensta/bin/sta | head -1)" /usr/local/bin/sta; \
    openroad -version && yosys -V && sta -version

# The whole sky130 process, not the one liberty file synthesis alone wanted: placement needs
# the cells' shapes and the metal stack, which live in LEF and the technology files. volare is
# the PDK manager that fetches a known-good build of them.
#
# OpenLane's own Python package is deliberately absent: its libparse dependency builds from
# source and wants a Rust toolchain, and it is a wrapper over the flow rather than the flow --
# OpenROAD reads the same TCL with or without it.
# Under $HOME, which the base image points at a world-writable /home/sandbox: volare follows it,
# and a PDK left in root's home is one the sandbox's own user cannot read.
RUN pip install --no-cache-dir volare \
 && volare enable --pdk sky130 $(volare ls-remote --pdk sky130 | head -1) \
 && test "$(find "$HOME/.volare" -name '*.tlef' | wc -l)" -gt 0 \
 && echo "sky130 pdk enabled with $(find "$HOME/.volare" -name '*.lef' | wc -l) lef files"
# volare nests a directory of its own name under the root it reports, and the tools want the
# one holding sky130A. Named here so a flow script does not have to go looking.
ENV PDK_ROOT=${HOME}/.volare/volare/sky130/versions PDK=sky130A
# ghdl: VHDL, so a design is not required to be Verilog to be simulated.
# (OpenSTA is not installed from Debian: OpenROAD below carries its own, newer, and the two
#   packages both own /usr/bin/sta, which makes dpkg refuse the second one outright.)
# z3, boolector: the solvers yosys-smtbmc drives, so equivalence between two versions of a
#   design can be PROVED rather than sampled with random vectors.
# nextpnr-ice40 + fpga-icestorm: place and route to a real FPGA, which answers "how many LUTs
#   and what Fmax" -- numbers a synthesis estimate cannot give.
# gcc-riscv64-unknown-elf: a CPU design is only as verified as the programs run on it.
# gtkwave: for its command-line converters; the viewer itself needs a display this has no use for.

# cocotb drives a simulation from Python, which is the language the agent writes best, so a
# testbench and its assertions are ordinary code rather than another language to get right.
RUN pip install --no-cache-dir cocotb cocotb-bus pyuvm pytest pyvcd amaranth

# SymbiYosys drives yosys-smtbmc and the solvers above. It installs with a Makefile rather
# than a wheel -- pip reads the repository and finds no Python project in it.
RUN git clone --depth 1 https://github.com/YosysHQ/sby.git /tmp/sby \
 && make -C /tmp/sby install \
 && rm -rf /tmp/sby \
 && sby --help >/dev/null 2>&1 && echo "sby installed"

# The two benchmarks this field reports against: VerilogEval (NVIDIA, specification to RTL)
# and RTLLM. Published frontier numbers are 89.74% and 96.08%, so a run here is comparable
# rather than anecdotal, and both ship their own testbenches.
RUN git clone --depth 1 https://github.com/NVlabs/verilog-eval.git /opt/verilog-eval \
 ; git clone --depth 1 https://github.com/hkust-zhiyao/RTLLM.git /opt/rtllm \
 ; true
ENV VERILOG_EVAL_DIR=/opt/verilog-eval RTLLM_DIR=/opt/rtllm

# A standard cell library with real timing and area, so synthesis reports square micrometres
# and a critical path rather than a count of abstract gates. Without it yosys maps to generic
# cells and an optimisation has nothing to move: this adder is 20 generic gates and 11 sky130
# ones, because sky130 has a majority gate and the generic library does not. One PVT corner
# (typical, 25C, 1.8V) of the high-density library is 12 MB; the whole PDK is gigabytes.
ADD https://raw.githubusercontent.com/efabless/skywater-pdk-libs-sky130_fd_sc_hd/master/timing/sky130_fd_sc_hd__tt_025C_1v80.lib /usr/share/pdk/sky130_fd_sc_hd__tt_025C_1v80.lib
ENV SKY130_LIB=/usr/share/pdk/sky130_fd_sc_hd__tt_025C_1v80.lib

ENV COCOTB_REDUCED_LOG_FMT=1

# Last layer: this image's own installs land as root. Directories only; see the base image.
RUN find /usr/local/lib/python3.13/site-packages /usr/local/bin -type d -exec chmod a+w {} +
