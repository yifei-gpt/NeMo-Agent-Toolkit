# Apptainer translation of Dockerfile.sandbox, for hosts with no container daemon.
# Kept beside it so the two are edited together; every RUN/ENV/CMD below mirrors one there.
# Read-only, runs as the caller: the Dockerfile's HOME and /usr/local steps have no counterpart
Bootstrap: docker
From: node:24-bookworm-slim
Stage: node

Bootstrap: docker
From: python:3.13-slim-bookworm
Stage: final

%files from node
    /usr/local/bin/node /usr/local/bin/node
    /usr/local/lib/node_modules /usr/local/lib/node_modules

%files
    sandbox.requirements.txt /app/requirements.txt
    local_sandbox_server.py /app/main.py

%post
    set -e
    # Two namespace workarounds, one cause: a host with no /etc/subuid entry maps a single UID,
    # so anything naming a second one fails with EINVAL.
    #   1. apt drops to _apt to fetch. Off, or every package is "unable to locate".
    #   2. fontconfig-config's postinst chowns /usr/local/share/fonts to root:staff -- gid 50,
    #      unmappable -- and every R graphics dependency behind it stays unconfigured. fakeroot
    #      does not reach it (dpkg runs the script's own chown), and a /usr/local/bin shim is not
    #      on the PATH dpkg gives maintainer scripts, so /usr/bin/chown itself stands aside for
    #      the one apt call that needs it, and is put back immediately after.
    echo 'APT::Sandbox::User "root";' > /etc/apt/apt.conf.d/00-no-sandbox
    apt update
    apt upgrade -y

    mv /usr/bin/chown /usr/bin/chown.real
    printf '#!/bin/sh\nexit 0\n' > /usr/bin/chown && chmod +x /usr/bin/chown
    apt install -y --no-install-recommends libexpat1 r-base-core r-cran-testthat \
        r-cran-ggplot2 r-cran-dplyr r-cran-tidyr r-cran-readr \
        r-cran-jsonlite r-cran-data.table \
        gcc g++ libc6-dev make cmake pkg-config \
        file xxd curl wget git sqlite3 catdoc jq ripgrep tree bc procps iptables \
        libreoffice-writer-nogui libreoffice-calc-nogui libreoffice-impress-nogui \
        pandoc poppler-utils tesseract-ocr imagemagick ffmpeg graphviz \
        fonts-liberation2 fonts-dejavu-core fonts-noto-cjk
    mv -f /usr/bin/chown.real /usr/bin/chown
    apt clean && rm -rf /var/lib/apt/lists/*

    ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm
    ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
    node --version && npm --version

    pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu
    pip install --no-cache-dir -r /app/requirements.txt
    mkdir -p /workspace

%environment
    export UWSGI_CHEAPER="${UWSGI_CHEAPER:-5}"
    export UWSGI_PROCESSES="${UWSGI_PROCESSES:-10}"
    # uwsgi's own default is 60s, which cut every call at a minute whatever the tool asked for.
    export UWSGI_HTTP_TIMEOUT=1200
    export LISTEN_PORT="${LISTEN_PORT:-6000}"
    # Host network: 0.0.0.0 would serve code execution to anyone who can reach this machine
    export LISTEN_HOST=127.0.0.1

%labels
    markagentx.tools Python 3.13 with numpy, pandas, scipy, scikit-learn, PyTorch (CPU), transformers, XGBoost, LightGBM, OpenCV and readers and writers for office files and PDFs; R with ggplot2 and dplyr; Node 24; gcc, cmake; LibreOffice (soffice --headless), pandoc, poppler (pdftotext), tesseract, ImageMagick, ffmpeg, Graphviz, jq, ripgrep.

# What `apptainer instance start` runs -- the CMD line, verbatim.
%startscript
    cd /app && exec python3 /app/main.py

%runscript
    cd /app && exec python3 /app/main.py
