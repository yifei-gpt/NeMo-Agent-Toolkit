# UWSGI_CHEAPER sets the number of initial uWSGI worker processes
# UWSGI_PROCESSES sets the maximum number of uWSGI worker processes
ARG UWSGI_CHEAPER=5
ARG UWSGI_PROCESSES=10

# Use the base image with Python 3.13
FROM python:3.13-slim-bookworm


# A task cannot install these for itself: since the sandbox stopped running as root it cannot apt
# at all, and even when it could the minutes came out of its own budget. The image was carrying
# Python.h and no compiler. The last five are what the runs reached for and did not find -- `file`
# alone 56 times, which is the first thing anything does with a document it was handed.
RUN apt update && \
    apt upgrade -y && \
    apt install -y --no-install-recommends libexpat1 r-base-core r-cran-testthat \
                                           gcc g++ libc6-dev make pkg-config \
                                           file xxd curl git sqlite3 && \
    apt clean && \
    rm -rf /var/lib/apt/lists/*

# Set up application code and install Python dependencies
COPY sandbox.requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY local_sandbox_server.py /app/main.py
# Any uid runs this, so the cwd, HOME and site-packages must be writable: a task's `pip install`
# has to reach the same place it did as root. Directories only -- writing a file needs its parent,
# and a recursive chmod copies all of site-packages into this layer.
ENV HOME=/home/sandbox
RUN mkdir -m 777 /workspace /home/sandbox \
 && find /usr/local/lib/python3.13/site-packages /usr/local/bin -type d -exec chmod a+w {} +

# Set Flask app environment variables and ports
ARG UWSGI_CHEAPER
ENV UWSGI_CHEAPER=$UWSGI_CHEAPER

ARG UWSGI_PROCESSES
ENV UWSGI_PROCESSES=$UWSGI_PROCESSES

# uwsgi's own default is 60s, which cut every call at a minute whatever the tool asked for -- the
# 900s the coding task sets was never reachable. Above the largest tool timeout, not equal to it.
ENV UWSGI_HTTP_TIMEOUT=1200

ENV LISTEN_PORT=6000
EXPOSE 6000

WORKDIR /app
CMD uwsgi --http 0.0.0.0:${LISTEN_PORT} --http-timeout ${UWSGI_HTTP_TIMEOUT} --socket-timeout ${UWSGI_HTTP_TIMEOUT} --harakiri ${UWSGI_HTTP_TIMEOUT} --master -p ${UWSGI_PROCESSES} --force-cwd /workspace -w main:app
